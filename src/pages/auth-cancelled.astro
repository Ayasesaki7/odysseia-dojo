	description="Discord 授权被取消时的访问资格说明。"
>
	<main class="public-shell narrow-shell">
		<section aria-labelledby="cancelled-title">
			<p class="eyebrow">受保护教程阅读</p>
			<h1 id="cancelled-title">Discord 授权未完成，无法验证您的访问资格。</h1>
			<a class="button button-secondary" href="/login">重新登录</a>
		</section>
	</main>
</PublicLayout>
